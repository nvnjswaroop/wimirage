# =============================================================================
# Wimirage — environment template
# =============================================================================
# Copy this file to `.env` and fill in the values you actually need.
# Anything left blank or commented out is treated as unset.
#
#   cp .env.example .env
#   set -a; source .env; set +a
#
# All variables below are *consumed* by the tool at runtime. Anything not
# listed here (e.g. log level, log file path, encrypted_logs, encryption
# key) is configured via the ``AppConfig`` dataclass in ``core/models.py`` —
# you can override those in ``config/app.yml`` (see CONFIG_PATH below).
# =============================================================================

# --- Twilio (SMS OTP delivery) ----------------------------------------------
# Section 3 #10: read at the moment the OTP service is instantiated so the
# values never appear in `ps aux` / `/proc/<pid>/cmdline`.
# TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_TOKEN=your-twilio-auth-token-here
# TWILIO_PHONE=+155****7890

# --- Admin token (gates any future /admin* routes — see portal/security.py) -
# Refused if unset/empty/shorter than 32 chars. Admin endpoints respond 401
# without it set, and tell the operator how to set one.
# CHAYAJALA_ADMIN_TOKEN=replace-with-32-or-more-chars-of-random-output

# --- Configuration file path ------------------------------------------------
# Section 2 #4: if unset, AppConfig.load() falls back to compile-time defaults.
# CONFIG_PATH=config/app.yml
